# Backend API
DATABASE_URL=sqlite:///./orders.db
CORS_ORIGINS=http://localhost:5173

# Email watcher (Gmail API polling for "Order Enquiry" attachments)
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET come from the OAuth client in
# Google Cloud Console -> APIs & Services -> Credentials. GOOGLE_REFRESH_TOKEN
# is produced once by running `python gmail_auth_setup.py` (see README).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
SUBJECT_FILTER=Order Enquiry
API_BASE_URL=http://localhost:8000
POLL_INTERVAL_SECONDS=60
COMPANY_NAME=Order Enquiry System
